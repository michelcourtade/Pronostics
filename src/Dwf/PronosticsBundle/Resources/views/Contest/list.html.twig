{% if myContests %}
<p class="small">{% trans %}My contests on event{% endtrans %} <strong>{{ event.name }}</strong></p>
    <ul class="list-group">
    {% for contest in myContests %}
        <li class="list-group-item">
            <span class="glyphicon glyphicon-arrow-right" aria-hidden="true"></span>
            <a href="{{ path('contest_show', { 'contestId': contest.id }) }}">{{ contest.contestName }}</a> ({{ contest.nbPlayers }} <span class="glyphicon glyphicon-user" aria-hidden="true"></span>)
            <a href="{{ path('contest_show', { 'contestId': contest.id }) }}">
                <span style="float: right" class="label label-primary">{{ 'Play'|trans }}</span>
            </a>
        </li>
    {% endfor %}
    </ul>
{% endif %}
{% if otherContests %}
    <ul>
    {% for contest in otherContests %}
        <li><a href="{{ path('contest_show', { 'contestId': contest.id }) }}">{{ contest.contestName }}</a></li>
    {% endfor %}
    </ul>
{% endif %}

{% include "DwfPronosticsBundle:Contest:_createForm.html.twig" with {'contestForm': contestForm } %}